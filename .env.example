# Copy this file to .env (local dev) and fill in your own values.
# NEVER commit your real .env file or API key.

# --- Groq (question generation + clinical summary) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY= 

# Any current Groq-hosted model works. See https://console.groq.com/docs/models
# for the up-to-date catalog. llama-3.1-8b-instant is a good free/fast default.
GROQ_MODEL=llama-3.1-8b-instant

# --- xAI / Grok (free-text response relevance classification only) ---
# Get a key at https://console.x.ai
XAI_API_KEY=

# Any current Grok model works. See https://docs.x.ai/docs/models for the
# up-to-date catalog. grok-4-fast is a good low-latency default for a
# lightweight yes/no relevance check.
XAI_MODEL=grok-4-fast

